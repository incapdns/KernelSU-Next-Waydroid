#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
libexec_dir=/usr/lib/kernelsu-next-waydroid
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -d $script_dir/kernel && -f $script_dir/packaging/PKGBUILD ]]; then
    repo_root=$script_dir
else
    repo_root=
fi

usage() {
    cat <<EOF
Usage: $program <command>

Source checkout:
  build       build kernelsu.ko
  package     build the module and create the Arch package
  install     install the newest generated Arch package (run as root)

Installed system:
  configure   configure Waydroid seccomp and LXC hooks (run as root)
  reload      stop Waydroid, then load the freshly unloaded module (run as root)
  audit       verify the container's effective mounts (run as root)
  uts         manage the Waydroid UTS hostname and domainname
  status      show the module, Waydroid, hooks and installed ksud
EOF
}

die() {
    echo "$program: $*" >&2
    exit 1
}

require_source() {
    [[ -n $repo_root ]] || die "this command must run from the project checkout."
}

require_root() {
    (( EUID == 0 )) || die "run this command as root."
}

private_command() {
    local installed_name=$1 source_name=$2
    shift 2
    if [[ -x $libexec_dir/$installed_name ]]; then
        exec "$libexec_dir/$installed_name" "$@"
    fi
    [[ -n $repo_root && -x $repo_root/packaging/$source_name ]] || \
        die "internal component is not installed: $installed_name"
    exec "$repo_root/packaging/$source_name" "$@"
}

build_module() {
    "$repo_root/kernel/build-waydroid-cachyos.sh"
}

build_all() {
    require_source
    build_module
}

newest_package() {
    local candidate newest=
    local -a packages

    require_source
    shopt -s nullglob
    packages=("$repo_root"/packaging/kernelsu-next-waydroid-*.pkg.tar.*)
    shopt -u nullglob
    ((${#packages[@]})) || die "no generated package was found; run '$program package' first."
    for candidate in "${packages[@]}"; do
        if [[ -z $newest || $candidate -nt $newest ]]; then
            newest=$candidate
        fi
    done
    printf '%s\n' "$newest"
}

show_status() {
    local config=/var/lib/waydroid/lxc/waydroid/config
    local module_path kernel_release
    local state_file=/run/kernelsu-next-waydroid/lifecycle.state

    if grep -q '^kernelsu ' /proc/modules; then
        echo "KernelSU: loaded"
    else
        echo "KernelSU: not loaded"
    fi
    if [[ -r $state_file ]]; then
        echo "Lifecycle: $(<"$state_file")"
    else
        echo "Lifecycle: unknown"
    fi
    if [[ -r /sys/module/kernelsu/parameters/proc_modules_hook_state ]]; then
        echo "Proc modules hook: $(</sys/module/kernelsu/parameters/proc_modules_hook_state)"
    else
        echo "Proc modules hook: unavailable"
    fi
    echo "SUS_PATH OverlayFS readdir: built into the SUSFS kernel"
    kernel_release=$(</proc/sys/kernel/osrelease)
    module_path=$(modinfo -k "$kernel_release" -n kernelsu 2>/dev/null || true)
    echo "Module for ${kernel_release}: ${module_path:-not installed}"
    echo "ksud source: embedded in the Manager APK"
    if command -v waydroid >/dev/null; then
        waydroid status 2>/dev/null || echo "Waydroid: unavailable"
    else
        echo "Waydroid: command not installed"
    fi
    if [[ -f $config ]] && \
       grep -Fq "$libexec_dir/pre-start-hook" "$config" && \
       grep -Fq "$libexec_dir/post-stop-hook" "$config" && \
       grep -Fq "$libexec_dir/aosp-mount-hook" "$config"; then
        echo "LXC hooks: configured"
    else
        echo "LXC hooks: not configured"
    fi
}

command_name=${1:-help}
shift || true
case $command_name in
    build)
        (($# == 0)) || die "build does not accept arguments."
        build_all
        ;;
    package)
        (($# == 0)) || die "package does not accept arguments."
        build_all
        (cd "$repo_root/packaging" && makepkg -f)
        echo "Package ready: $(newest_package)"
        ;;
    install)
        (($# == 0)) || die "install does not accept arguments."
        require_source
        require_root
        package_file=$(newest_package)
        pacman -U -- "$package_file"
        ;;
    configure)
        require_root
        private_command configure configure-waydroid-kernelsu "$@"
        ;;
    reload)
        require_root
        (($# == 0)) || die "reload does not accept arguments."
        waydroid container stop
        if grep -q '^kernelsu ' /proc/modules; then
            die "KernelSU remained loaded after Waydroid stopped; inspect the post-stop hook."
        fi
        private_command load-module load-kernelsu
        ;;
    audit)
        require_root
        private_command audit kernelsu-waydroid-aosp-mount-audit "$@"
        ;;
    uts)
        private_command uts kernelsu-waydroid-uts "$@"
        ;;
    status)
        (($# == 0)) || die "status does not accept arguments."
        show_status
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        die "unknown command: $command_name"
        ;;
esac
