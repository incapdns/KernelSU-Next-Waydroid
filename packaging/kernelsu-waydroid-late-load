#!/usr/bin/env bash
set -euo pipefail

android_shell() {
    waydroid shell -- sh -c "$1"
}

deploy_packaged_ksud() {
    local init_pid=$1
    [[ -x $packaged_ksud ]] || return 0
    nsenter --target "$init_pid" \
        --mount --uts --ipc --net --pid --cgroup --root --wd \
        -- /system/bin/sh -c \
        '/system/bin/toybox cat > /data/adb/ksud.waydroid-new && /system/bin/toybox chmod 0755 /data/adb/ksud.waydroid-new && /system/bin/toybox mv -f /data/adb/ksud.waydroid-new /data/adb/ksud' \
        < "$packaged_ksud"
}

if (( EUID != 0 )); then
    echo "${0##*/}: execute como root." >&2
    exit 1
fi

grep -q '^kernelsu ' /proc/modules || exit 0
waydroid status 2>/dev/null | grep -q $'Container:\tRUNNING' || exit 0
waydroid_init_pid=$(lxc-info -P /var/lib/waydroid/lxc -n waydroid -pH 2>/dev/null || true)
[[ $waydroid_init_pid =~ ^[0-9]+$ ]] || exit 1

ready=$(android_shell \
    'test "$(getprop sys.boot_completed)" = 1 && echo yes' \
    2>/dev/null || true)
[[ $ready == *yes* ]] || exit 0

ksud_was_missing=$(android_shell 'test -x /data/adb/ksud || echo yes' 2>/dev/null || true)

# Keep the Waydroid daemon synchronized with this package. Manager operations
# may restore the APK-embedded ksud, which does not contain our late-load
# post-fs-data compatibility stage.
packaged_ksud=/usr/lib/kernelsu-next-waydroid/ksud-x86_64
deploy_packaged_ksud "$waydroid_init_pid"

init_start=$(android_shell "awk '{print \$22}' /proc/1/stat" 2>/dev/null | tail -n1)
[[ $init_start =~ ^[0-9]+$ ]] || exit 0

previous=$(android_shell \
    'test -f /data/adb/ksu/.waydroid_late_load && cat /data/adb/ksu/.waydroid_late_load || true' \
    2>/dev/null | tail -n1)
completion_marker=$(android_shell \
    'test -f /data/adb/ksu/.waydroid_late_load_complete && cat /data/adb/ksu/.waydroid_late_load_complete || true' \
    2>/dev/null | tail -n1)

# A module can be installed after the boot's first late-load. Do not let the
# per-container completion marker suppress the follow-up run that promotes it
# from modules_update into modules.
had_pending_updates=$(android_shell \
    'test -d /data/adb/modules_update && test -n "$(ls -A /data/adb/modules_update 2>/dev/null)" && echo yes || true' \
    2>/dev/null || true)
[[ $previous != "$init_start" || $completion_marker != "$init_start" ||
   $had_pending_updates == *yes* || $ksud_was_missing == *yes* ]] || exit 0

manager_package=$(android_shell '
    for package in $(pm list packages -3 | sed "s/^package://"); do
        apk=$(pm path "$package" 2>/dev/null | sed -n "s/^package://p" | head -n1)
        test -n "$apk" || continue
        if unzip -l "$apk" "lib/x86_64/libksud.so" 2>/dev/null | grep -q "lib/x86_64/libksud.so"; then
            echo "$package"
            exit 0
        fi
    done
' 2>/dev/null | tail -n1)
manager_package=${manager_package:-com.rifsxd.ksunext}
manager_pid_before=$(android_shell "pidof '$manager_package' || true" 2>/dev/null | tail -n1)

# waydroid shell inherits the container's seccomp filter, which kills the
# reboot(2)-based KernelSU bootstrap transport. Enter the Android namespaces
# from an unfiltered host process instead; -r and -w adopt init's root/cwd.
nsenter --target "$waydroid_init_pid" \
    --mount --uts --ipc --net --pid --cgroup --root --wd \
    -- /system/bin/sh -c '
        export PATH=/system/bin:/system/xbin:/vendor/bin:/product/bin:/apex/com.android.runtime/bin
        export ANDROID_ROOT=/system
        export ANDROID_DATA=/data
        exec /data/adb/ksud late-load --package-name "$1"
    ' sh "$manager_package"

# ksud daemonizes, so its direct caller exits before the stages finish. The
# patched daemon writes init's start time after all blocking stages. A Manager
# PID change is retained only as a compatibility fallback for an older daemon.
for _ in $(seq 1 90); do
    completion_marker=$(android_shell \
        'test -f /data/adb/ksu/.waydroid_late_load_complete && cat /data/adb/ksu/.waydroid_late_load_complete || true' \
        2>/dev/null | tail -n1)
    manager_pid_after=$(android_shell "pidof '$manager_package' || true" 2>/dev/null | tail -n1)
    updates_promoted=
    if [[ $had_pending_updates == *yes* ]]; then
        updates_pending=$(android_shell \
            'test -d /data/adb/modules_update && test -n "$(ls -A /data/adb/modules_update 2>/dev/null)" && echo yes || true' \
            2>/dev/null || true)
        [[ $updates_pending != *yes* ]] && updates_promoted=yes
    fi
    if [[ $completion_marker == "$init_start" ||
          ( $had_pending_updates == *yes* && $updates_promoted == yes ) ||
          ( $had_pending_updates != *yes* && -n $manager_pid_after && $manager_pid_after != "$manager_pid_before" ) ]]; then
        # Manager startup may restore the APK-embedded daemon. Make our patched
        # binary the persistent copy after observing that restart.
        deploy_packaged_ksud "$waydroid_init_pid"
        android_shell "printf '%s\\n' '$init_start' > /data/adb/ksu/.waydroid_late_load"
        exit 0
    fi
    sleep 2
done

echo "${0##*/}: ksud late-load did not restart $manager_package" >&2
exit 1
