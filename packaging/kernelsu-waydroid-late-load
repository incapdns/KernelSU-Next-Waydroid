#!/usr/bin/env bash
set -euo pipefail

android_shell() {
    waydroid shell -- sh -c "$1"
}

if (( EUID != 0 )); then
    echo "${0##*/}: execute como root." >&2
    exit 1
fi

grep -q '^kernelsu ' /proc/modules || exit 1
waydroid status 2>/dev/null | grep -q $'Container:\tRUNNING' || exit 1

ready=$(android_shell \
    'test "$(getprop sys.boot_completed)" = 1 && test -x /data/adb/ksud && echo yes' \
    2>/dev/null || true)
[[ $ready == *yes* ]] || exit 1

init_start=$(android_shell "awk '{print \$22}' /proc/1/stat" 2>/dev/null | tail -n1)
[[ $init_start =~ ^[0-9]+$ ]] || exit 1

previous=$(android_shell \
    'test -f /data/adb/ksu/.waydroid_late_load && cat /data/adb/ksu/.waydroid_late_load || true' \
    2>/dev/null | tail -n1)
[[ $previous != "$init_start" ]] || exit 0

manager_package=com.rifsxd.ksunext
manager_pid_before=$(android_shell "pidof '$manager_package' || true" 2>/dev/null | tail -n1)
android_shell '/data/adb/ksud late-load'

# ksud daemonizes. Its final successful step force-stops and starts Manager;
# use the new Manager PID as an observable completion signal.
for _ in $(seq 1 90); do
    manager_pid_after=$(android_shell "pidof '$manager_package' || true" 2>/dev/null | tail -n1)
    if [[ -n $manager_pid_after && $manager_pid_after != "$manager_pid_before" ]]; then
        android_shell "printf '%s\\n' '$init_start' > /data/adb/ksu/.waydroid_late_load"
        exit 0
    fi
    sleep 2
done

echo "${0##*/}: ksud late-load did not restart $manager_package" >&2
exit 1
