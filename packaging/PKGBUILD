pkgname=kernelsu-next-waydroid
pkgver=waydroid.dev.2026.08.19.r4.r0.g32cd7b57.mountfix1
pkgrel=1
epoch=1
pkgdesc='KernelSU Next dev host module for Waydroid on CachyOS x86_64'
arch=('x86_64')
license=('GPL-2.0-only')
depends=('modloader' 'waydroid' 'util-linux')
conflicts=('kernelsu-dkms' 'kernelsu-waydroid-current')
provides=('kernelsu-dkms')
options=('!strip')
backup=('etc/kernelsu-next-waydroid/uts-identity.conf')
install=kernelsu-next-waydroid.install
source=()
sha256sums=()

pkgver() {
    git -C "$(realpath "$startdir/..")" describe --tags --long --always \
        --dirty=.mountfix1 | sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/; s/[^[:alnum:].]+/./g'
}

package() {
    local repo_root module kernel_release
    repo_root=$(realpath "$startdir/..")
    module="$repo_root/kernel/out-waydroid/kernelsu.ko"
    [[ -f $module ]] || {
        error "missing $module; run ./waydroid-kernelsu package"
        return 1
    }
    kernel_release=$(modinfo -F vermagic "$module" | awk '{print $1}')

    install -Dm0644 "$module" \
        "$pkgdir/usr/lib/modules/$kernel_release/updates/kernelsu.ko"
    install -Dm0755 "$repo_root/waydroid-kernelsu" \
        "$pkgdir/usr/bin/waydroid-kernelsu"
    install -Dm0755 "$repo_root/packaging/load-kernelsu" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/load-module"
    install -Dm0755 "$repo_root/packaging/configure-waydroid-kernelsu" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/configure"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-aosp-mount-audit" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/audit"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-aosp-mount-hook" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/aosp-mount-hook"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-uts" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/uts"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-configure-osrelease" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/configure-osrelease"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-sync-brene-uts" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/sync-brene-uts"
    install -Dm0644 "$repo_root/packaging/uts-identity.conf" \
        "$pkgdir/etc/kernelsu-next-waydroid/uts-identity.conf"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-pre-start-hook" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/pre-start-hook"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-post-stop-hook" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/post-stop-hook"
    install -Dm0755 "$repo_root/packaging/kernelsu-waydroid-unload" \
        "$pkgdir/usr/lib/kernelsu-next-waydroid/unload"
    install -Dm0644 "$repo_root/packaging/kernelsu-waydroid-unload.service" \
        "$pkgdir/usr/lib/systemd/system/kernelsu-waydroid-unload.service"
    install -Dm0644 "$repo_root/packaging/kernelsu-waydroid-unload.timer" \
        "$pkgdir/usr/lib/systemd/system/kernelsu-waydroid-unload.timer"
}
