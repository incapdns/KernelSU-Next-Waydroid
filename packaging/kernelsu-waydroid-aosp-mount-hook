#!/usr/bin/env bash
set -euo pipefail

log() {
    logger -t kernelsu-waydroid-aosp-mount-hook -- "$*" 2>/dev/null || true
}
trap 'status=$?; log "failed at line $LINENO with status $status"' ERR

# LXC runs this hook in the container mount namespace after lxc.mount.auto has
# mounted procfs and before pivot_root starts Android init. AOSP
# first_stage_init remounts procfs with these exact data options, but under
# Waydroid LXC owns the initial mount.
: "${LXC_ROOTFS_MOUNT:?LXC_ROOTFS_MOUNT is not set by LXC}"

proc_mount=$LXC_ROOTFS_MOUNT/proc
data_mount=$LXC_ROOTFS_MOUNT/data
waydroid_prop_mount=$LXC_ROOTFS_MOUNT/vendor/waydroid.prop
host_permissions_mount=$LXC_ROOTFS_MOUNT/vendor/etc/host-permissions
uts_config=/etc/kernelsu-next-waydroid/uts-identity.conf
log "rootfs=$LXC_ROOTFS_MOUNT proc=$proc_mount data=$data_mount"
[[ -d $proc_mount ]] || {
    echo "${0##*/}: proc mountpoint does not exist: $proc_mount" >&2
    exit 1
}

valid_uts_name() {
    local value=$1 label
    [[ -n $value && ${#value} -le 64 ]] || return 1
    [[ $value != .* && $value != *. && $value != *..* ]] || return 1
    while IFS= read -r label; do
        [[ $label =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ || \
           $label =~ ^[A-Za-z0-9]$ ]] || return 1
    done < <(tr '.' '\n' <<< "$value")
}

apply_uts_identity() {
    local enabled=0 configured_hostname= configured_domainname= key value
    [[ -r $uts_config ]] || return 0
    while IFS='=' read -r key value; do
        case $key in
            enabled) enabled=$value ;;
            hostname) configured_hostname=$value ;;
            domainname) configured_domainname=$value ;;
        esac
    done < "$uts_config"
    [[ $enabled == 1 ]] || return 0
    valid_uts_name "$configured_hostname" || {
        echo "${0##*/}: invalid configured UTS hostname: $configured_hostname" >&2
        exit 1
    }
    valid_uts_name "$configured_domainname" || {
        echo "${0##*/}: invalid configured UTS domainname: $configured_domainname" >&2
        exit 1
    }

    # LXC protects /proc/sys with a read-only bind. Temporarily lift only that
    # container-side VFS flag, write the two UTS fields, and restore it before
    # Android init can run. The proc superblock and host mount are untouched.
    mount -o remount,bind,rw "$proc_mount/sys"
    printf '%s\n' "$configured_hostname" > "$proc_mount/sys/kernel/hostname"
    printf '%s\n' "$configured_domainname" > "$proc_mount/sys/kernel/domainname"
    mount -o remount,bind,ro "$proc_mount/sys"
    [[ $(<"$proc_mount/sys/kernel/hostname") == "$configured_hostname" ]] || {
        echo "${0##*/}: failed to verify the UTS hostname" >&2
        exit 1
    }
    [[ $(<"$proc_mount/sys/kernel/domainname") == "$configured_domainname" ]] || {
        echo "${0##*/}: failed to verify the UTS domainname" >&2
        exit 1
    }
    log "UTS identity applied: hostname=$configured_hostname domainname=$configured_domainname namespace=$(readlink /proc/self/ns/uts 2>/dev/null || true)"
}

# first_stage_init.cpp passes mount flags 0 for proc. LXC initially adds
# nosuid,nodev,noexec; explicitly clear those VFS flags as well as applying the
# literal Android data options. This audit targets equivalence, not a merely
# stricter-looking approximation.
mount -t proc -o remount,rw,suid,dev,exec,hidepid=2,gid=3009 proc "$proc_mount"

# hostname and domainname are properties of the container's UTS namespace.
# Applying them here changes only Waydroid and happens before Android init.
apply_uts_identity

# Do not change the LXC-created /dev root from 01777 to AOSP's literal 0755.
# Waydroid's hwcomposer runs outside Android's root context and creates the
# /dev/input/wl_* FIFOs only after learning the Wayland seat capabilities.
# A 0755 root prevents that mkdir, removing mouse and keyboard input. This is a
# proven Waydroid architectural divergence, not an exact AOSP mount.

# init-debug.rc mounts debugfs only when the product property is exactly true.
# This image does not define that property, while LXC adds debugfs
# unconditionally. Remove the container-side mount before Android init.
debug_mount=$LXC_ROOTFS_MOUNT/sys/kernel/debug
if mountpoint -q "$debug_mount"; then
    umount "$debug_mount"
fi

# fstab.ranchu.x86 for the matching AOSP build requests noatime,nosuid,nodev
# for /data. Waydroid supplies /data as a host bind mount, so apply the VFS
# flags to the container bind only; the host Btrfs mount remains unchanged.
if mountpoint -q "$data_mount"; then
    log "data before remount: $(findmnt -rn -o TARGET,VFS-OPTIONS,FS-OPTIONS -T "$data_mount" || true)"
    # A bind remount accepts VFS flags only. Preserve the existing rw/noatime
    # state and add the two missing AOSP VFS restrictions.
    mount -o remount,bind,nosuid,nodev "$data_mount"
    log "data after remount: $(findmnt -rn -o TARGET,VFS-OPTIONS,FS-OPTIONS -T "$data_mount" || true)"
else
    echo "${0##*/}: data mountpoint does not exist: $data_mount" >&2
    exit 1
fi

# AOSP fstab mounts /vendor read-only. Waydroid adds these host bind mounts
# below the read-only vendor overlay; remount the container-side binds read-only
# so they do not punch writable holes through the AOSP vendor policy.
for vendor_bind in "$waydroid_prop_mount" "$host_permissions_mount"; do
    if mountpoint -q "$vendor_bind"; then
        mount -o remount,bind,ro "$vendor_bind"
    else
        echo "${0##*/}: expected vendor bind mount does not exist: $vendor_bind" >&2
        exit 1
    fi
done

# Verify the effective superblock options, not merely a successful mount(8)
# exit. mountinfo field 5 is the mountpoint and fields after " - " include the
# procfs superblock options where hidepid/gid are reported by the kernel.
mountinfo=$(awk -v target="$proc_mount" '$5 == target { print; exit }' /proc/self/mountinfo)
[[ -n $mountinfo ]] || {
    echo "${0##*/}: proc mount disappeared after remount" >&2
    exit 1
}

case ",$mountinfo," in
    *,hidepid=2,*|*,hidepid=invisible,*) ;;
    *) echo "${0##*/}: effective proc mount lacks hidepid=2: $mountinfo" >&2; exit 1 ;;
esac
proc_vfs_options=$(awk -v target="$proc_mount" '$5 == target { print $6; exit }' /proc/self/mountinfo)
for forbidden in nosuid nodev noexec; do
    case ",$proc_vfs_options," in
        *,"$forbidden",*)
            echo "${0##*/}: effective proc mount has non-AOSP flag $forbidden: $proc_vfs_options" >&2
            exit 1
            ;;
    esac
done

data_mountinfo=$(awk -v target="$data_mount" '$5 == target { print $6; exit }' /proc/self/mountinfo)
for required in noatime nosuid nodev; do
    case ",$data_mountinfo," in
        *,"$required",*) ;;
        *) echo "${0##*/}: effective data mount lacks $required: $data_mountinfo" >&2; exit 1 ;;
    esac
done
for vendor_bind in "$waydroid_prop_mount" "$host_permissions_mount"; do
    vendor_options=$(awk -v target="$vendor_bind" '$5 == target { print $6; exit }' /proc/self/mountinfo)
    case ",$vendor_options," in
        *,ro,*) ;;
        *) echo "${0##*/}: effective vendor bind is not read-only: $vendor_bind $vendor_options" >&2; exit 1 ;;
    esac
done
case ",$mountinfo," in
    *,gid=3009,*|*,gid=readproc,*) ;;
    *) echo "${0##*/}: effective proc mount lacks gid=3009: $mountinfo" >&2; exit 1 ;;
esac
