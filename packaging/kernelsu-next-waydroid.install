post_install() {
    local module_dir
    for module_dir in /usr/lib/modules/*/updates/kernelsu.ko; do
        [[ -e $module_dir ]] || continue
        depmod -a "$(basename "$(dirname "$(dirname "$module_dir")")")"
    done
    systemctl daemon-reload
    # Normal Android post-fs-data is now triggered before the first Zygote by
    # the kernel boot hook. Keep late-load available as a manual recovery tool,
    # but do not race it periodically against an ordinary container boot.
    systemctl stop kernelsu-waydroid-late-load.timer \
        kernelsu-waydroid-late-load.service 2>/dev/null || true
    if [[ -x /usr/bin/configure-waydroid-kernelsu && \
          -f /var/lib/waydroid/lxc/waydroid/config ]]; then
        /usr/bin/configure-waydroid-kernelsu
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl stop kernelsu-waydroid-late-load.service 2>/dev/null || true
}

post_remove() {
    depmod -a
    systemctl daemon-reload
}
