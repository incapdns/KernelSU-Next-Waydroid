post_install() {
    local module_dir
    for module_dir in /usr/lib/modules/*/updates/kernelsu.ko; do
        [[ -e $module_dir ]] || continue
        depmod -a "$(basename "$(dirname "$(dirname "$module_dir")")")"
    done
    systemctl daemon-reload
    # Remove the obsolete periodic retry from installations predating pkgrel 37.
    # Manual late-load recovery remains available through the static service.
    systemctl stop kernelsu-waydroid-late-load.timer \
        kernelsu-waydroid-late-load.service 2>/dev/null || true
    systemctl disable kernelsu-waydroid-late-load.timer 2>/dev/null || true
    if [[ -x /usr/bin/waydroid-kernelsu && \
          -f /var/lib/waydroid/lxc/waydroid/config ]]; then
        /usr/bin/waydroid-kernelsu configure
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now kernelsu-waydroid-late-load.timer 2>/dev/null || true
    systemctl stop kernelsu-waydroid-late-load.service 2>/dev/null || true
}

post_remove() {
    depmod -a
    systemctl daemon-reload
}
