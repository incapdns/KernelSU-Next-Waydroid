#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
    echo "${0##*/}: execute as root." >&2
    exit 1
fi

waydroid_init_pid=$(lxc-info -P /var/lib/waydroid/lxc -n waydroid -pH 2>/dev/null || true)
[[ $waydroid_init_pid =~ ^[0-9]+$ ]] || {
    echo "${0##*/}: Waydroid container is not running." >&2
    exit 1
}

mountinfo_file=$(mktemp /tmp/kernelsu-waydroid-mountinfo.XXXXXX)
trap 'rm -f -- "$mountinfo_file"' EXIT
nsenter --target "$waydroid_init_pid" --mount --pid --root --wd -- \
    /system/bin/cat /proc/self/mountinfo > "$mountinfo_file"

container_getprop() {
    nsenter --target "$waydroid_init_pid" --mount --pid --root --wd -- \
        /system/bin/getprop "$1" 2>/dev/null | tr -d '\r'
}

android_sdk=$(container_getprop ro.build.version.sdk)
[[ $android_sdk =~ ^[0-9]+$ ]] || {
    echo "${0##*/}: could not determine the Android SDK level." >&2
    exit 1
}
apex_updatable=$(container_getprop ro.apex.updatable)
printf 'Android SDK: %s; updatable APEX: %s\n' "$android_sdk" "${apex_updatable:-false}"

read_mountinfo() {
    awk -v target="$1" '$5 == target { print; exit }' "$mountinfo_file"
}

check_option() {
    local mountpoint=$1 option=$2 alternative=${3:-} line haystack
    line=$(read_mountinfo "$mountpoint")
    if [[ -z $line ]]; then
        printf 'FAIL %-24s missing mount\n' "$mountpoint"
        return 1
    fi
    haystack=${line// /,}
    if [[ ,$haystack, == *,$option,* || ( -n $alternative && ,$haystack, == *,$alternative,* ) ]]; then
        printf 'PASS %-24s %s\n' "$mountpoint" "$option"
    else
        printf 'FAIL %-24s missing %s\n     %s\n' "$mountpoint" "$option" "$line"
        return 1
    fi
}

check_no_option() {
    local mountpoint=$1 option=$2 line haystack
    line=$(read_mountinfo "$mountpoint")
    if [[ -z $line ]]; then
        printf 'FAIL %-24s missing mount\n' "$mountpoint"
        return 1
    fi
    haystack=${line// /,}
    if [[ ,$haystack, == *,$option,* ]]; then
        printf 'FAIL %-24s unexpected %s\n     %s\n' "$mountpoint" "$option" "$line"
        return 1
    fi
    printf 'PASS %-24s lacks %s\n' "$mountpoint" "$option"
}

check_root() {
    local mountpoint=$1 expected=$2 line actual
    line=$(read_mountinfo "$mountpoint")
    actual=$(awk '{ print $4 }' <<< "$line")
    if [[ $actual == "$expected" ]]; then
        printf 'PASS %-24s root=%s\n' "$mountpoint" "$expected"
    else
        printf 'FAIL %-24s expected root=%s, got root=%s\n' "$mountpoint" "$expected" "${actual:-missing}"
        return 1
    fi
}

check_root_suffix() {
    local mountpoint=$1 expected_suffix=$2 line actual
    line=$(read_mountinfo "$mountpoint")
    actual=$(awk '{ print $4 }' <<< "$line")
    if [[ $actual == *"$expected_suffix" ]]; then
        printf 'PASS %-24s root=*%s\n' "$mountpoint" "$expected_suffix"
    else
        printf 'FAIL %-24s expected root suffix=%s, got root=%s\n' \
            "$mountpoint" "$expected_suffix" "${actual:-missing}"
        return 1
    fi
}

check_propagation() {
    local mountpoint=$1 expect_shared=$2 expect_master=$3 line optional
    line=$(read_mountinfo "$mountpoint")
    [[ -n $line ]] || {
        printf 'FAIL %-24s missing mount\n' "$mountpoint"
        return 1
    }
    optional=$(awk '{ for (i=7; i<=NF && $i != "-"; i++) printf "%s%s", (i==7 ? "" : " "), $i }' <<< "$line")
    case "$expect_shared:$optional" in
        yes:*shared:*) ;;
        no:*shared:*)
            printf 'FAIL %-24s unexpectedly shared: %s\n' "$mountpoint" "$optional"
            return 1 ;;
        yes:*)
            printf 'FAIL %-24s missing shared peer group: %s\n' "$mountpoint" "$optional"
            return 1 ;;
    esac
    case "$expect_master:$optional" in
        yes:*master:*) ;;
        no:*master:*)
            printf 'FAIL %-24s unexpectedly slave/master: %s\n' "$mountpoint" "$optional"
            return 1 ;;
        yes:*)
            printf 'FAIL %-24s missing slave/master relation: %s\n' "$mountpoint" "$optional"
            return 1 ;;
    esac
    printf 'PASS %-24s propagation shared=%s master=%s\n' \
        "$mountpoint" "$expect_shared" "$expect_master"
}

check_every_target_option() {
    local mountpoint=$1 option=$2 line haystack count=0
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        (( count += 1 )) || true
        haystack=${line// /,}
        if [[ ,$haystack, != *,$option,* ]]; then
            printf 'FAIL %-24s instance lacks %s\n     %s\n' "$mountpoint" "$option" "$line"
            return 1
        fi
    done < <(awk -v target="$mountpoint" '$5 == target { print }' "$mountinfo_file")
    if (( count == 0 )); then
        printf 'FAIL %-24s missing mount\n' "$mountpoint"
        return 1
    fi
    printf 'PASS %-24s all %d instance(s) have %s\n' "$mountpoint" "$count" "$option"
}

check_stat() {
    local mountpoint=$1 expected_mode=$2 expected_uid=$3 expected_gid=$4 actual
    actual=$(nsenter --target "$waydroid_init_pid" --mount --pid --root --wd -- \
        /system/bin/stat -c '%a %u %g' "$mountpoint" 2>/dev/null || true)
    if [[ $actual == "$expected_mode $expected_uid $expected_gid" ]]; then
        printf 'PASS %-24s mode=%s uid=%s gid=%s\n' \
            "$mountpoint" "$expected_mode" "$expected_uid" "$expected_gid"
    else
        printf 'FAIL %-24s expected stat="%s %s %s", got "%s"\n' \
            "$mountpoint" "$expected_mode" "$expected_uid" "$expected_gid" "${actual:-missing}"
        return 1
    fi
}

check_char_device() {
    local path=$1 expected_major=$2 expected_minor=$3 actual
    actual=$(nsenter --target "$waydroid_init_pid" --mount --pid --root --wd -- \
        /system/bin/sh -c 'test -c "$1" && /system/bin/stat -c "%t %T" "$1"' sh "$path" \
        2>/dev/null || true)
    if [[ $actual == "$expected_major $expected_minor" ]]; then
        printf 'PASS %-24s char=%s:%s\n' "$path" "$expected_major" "$expected_minor"
    else
        printf 'FAIL %-24s expected char=%s:%s, got "%s"\n' \
            "$path" "$expected_major" "$expected_minor" "${actual:-missing}"
        return 1
    fi
}

check_fs() {
    local mountpoint=$1 expected=$2 line actual
    line=$(read_mountinfo "$mountpoint")
    actual=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "-") { print $(i + 1); exit } }' <<< "$line")
    if [[ $actual == "$expected" ]]; then
        printf 'PASS %-24s fs=%s\n' "$mountpoint" "$expected"
    else
        printf 'FAIL %-24s expected fs=%s, got fs=%s\n' "$mountpoint" "$expected" "${actual:-missing}"
        return 1
    fi
}

check_fs_one_of() {
    local mountpoint=$1 expected_csv=$2 line actual
    line=$(read_mountinfo "$mountpoint")
    actual=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "-") { print $(i + 1); exit } }' <<< "$line")
    if [[ ,$expected_csv, == *,$actual,* ]]; then
        printf 'PASS %-24s fs=%s\n' "$mountpoint" "$actual"
    else
        printf 'FAIL %-24s expected fs in {%s}, got fs=%s\n' \
            "$mountpoint" "$expected_csv" "${actual:-missing}"
        return 1
    fi
}

check_absent() {
    local mountpoint=$1 reason=$2
    if [[ -n $(read_mountinfo "$mountpoint") ]]; then
        printf 'FAIL %-24s unexpectedly mounted (%s)\n' "$mountpoint" "$reason"
        return 1
    fi
    printf 'INFO %-24s absent: %s\n' "$mountpoint" "$reason"
}

classify_mount() {
    local target=$1
    case "$target" in
        /proc|/mnt|/apex|/linkerconfig|/config|/sys/kernel/tracing|/sys/fs/fuse/connections|/sys/fs/bpf|/sys/fs/pstore|/data_mirror|/mnt/vm|/sys/kernel/security)
            printf '%s' AOSP_STATIC_EXACT ;;
        /apex/*)
            if [[ $apex_updatable == true ]]; then
                printf '%s' AOSP_PACKAGED_APEX_EXACT
            else
                # android-13.0.0_r75 apexd ActivateFlattenedApex(): MS_BIND.
                printf '%s' AOSP_FLATTENED_APEX_EXACT
            fi ;;
        /storage|/data/user/0|/data_mirror/*)
            printf '%s' AOSP_BIND_EQUIVALENT ;;
        /mnt/user/*|/mnt/installer|/mnt/installer/*|/mnt/androidwritable|/mnt/androidwritable/*|/mnt/pass_through/*|/storage/emulated|/storage/emulated/*)
            # android-13.0.0_r75 vold dynamic FUSE/bind topology.
            printf '%s' AOSP_VOLD_DYNAMIC ;;
        /)
            printf '%s' WAYDROID_ROOT_SUBSTITUTION ;;
        /vendor)
            printf '%s' WAYDROID_PARTITION_SUBSTITUTION ;;
        /data)
            printf '%s' WAYDROID_DATA_SUBSTITUTION ;;
        /metadata)
            printf '%s' WAYDROID_METADATA_SUBSTITUTION ;;
        /dev|/sys|/sys/kernel/debug)
            printf '%s' SHARED_KERNEL_DIVERGENCE ;;
        /dev/pts)
            if (( android_sdk >= 37 )); then
                printf '%s' AOSP_STATIC_EXACT
            else
                printf '%s' SHARED_KERNEL_DIVERGENCE
            fi ;;
        /dev/binder|/dev/hwbinder|/dev/vndbinder)
            printf '%s' LXC_DEVICE_SUBSTITUTION ;;
        /dev/*)
            printf '%s' LXC_HOST_DEVICE_BIND ;;
        /proc/sys|/proc/sys/net|/proc/sysrq-trigger)
            printf '%s' LXC_PROC_SECURITY_BIND ;;
        /proc/sys/fs/binfmt_misc)
            printf '%s' WAYDROID_TRANSLATION_EXTENSION ;;
        /sys/fs/cgroup)
            printf '%s' LXC_CGROUP_SUBSTITUTION ;;
        /mnt_extra|/tmp|/var|/run|/run/xdg/*)
            printf '%s' WAYDROID_RUNTIME_EXTENSION ;;
        /vendor/waydroid.prop|/vendor/etc/host-permissions|/vendor/etc/vintf/manifest/*)
            printf '%s' WAYDROID_VENDOR_EXTENSION ;;
        *)
            return 1 ;;
    esac
}

failed=0
check_fs /proc proc || failed=1
check_option /proc hidepid=2 hidepid=invisible || failed=1
check_option /proc gid=3009 gid=readproc || failed=1
check_no_option /proc nosuid || failed=1
check_no_option /proc nodev || failed=1
check_no_option /proc noexec || failed=1
check_option /data noatime || failed=1
check_option /data nosuid || failed=1
check_option /data nodev || failed=1
check_option /vendor/waydroid.prop ro || failed=1
check_option /vendor/etc/host-permissions ro || failed=1
check_option /mnt nosuid || failed=1
check_option /mnt nodev || failed=1
check_option /mnt noexec || failed=1
check_option /apex nosuid || failed=1
check_option /apex nodev || failed=1
check_option /apex noexec || failed=1
check_option /linkerconfig nosuid || failed=1
check_option /linkerconfig nodev || failed=1
check_option /linkerconfig noexec || failed=1
check_option /config nosuid || failed=1
check_option /config nodev || failed=1
check_option /config noexec || failed=1
check_option /sys/fs/bpf nosuid || failed=1
check_option /sys/fs/bpf nodev || failed=1
check_option /sys/fs/bpf noexec || failed=1
check_option /sys/fs/pstore nosuid || failed=1
check_option /sys/fs/pstore nodev || failed=1
check_option /sys/fs/pstore noexec || failed=1
check_option / ro || failed=1
check_option / nodev || failed=1
check_option /vendor ro || failed=1
check_every_target_option /vendor ro || failed=1
check_option /dev nosuid || failed=1
check_fs /dev/pts devpts || failed=1
if (( android_sdk >= 37 )); then
    # Android 17 remounts the existing devpts instance without legacy mount
    # data. Its effective kernel defaults are the expected final state.
    check_no_option /dev/pts nodev || failed=1
    check_option /dev/pts mode=600 || failed=1
    check_option /dev/pts ptmxmode=000 || failed=1
else
    # LXC owns PTY allocation on the Android 13 baseline and intentionally
    # replaces the literal AOSP mount with Waydroid's isolation contract.
    check_option /dev/pts nosuid || failed=1
    check_no_option /dev/pts nodev || failed=1
    check_option /dev/pts noexec || failed=1
    check_option /dev/pts gid=5 || failed=1
    check_option /dev/pts mode=620 || failed=1
    check_option /dev/pts ptmxmode=666 || failed=1
    check_option /dev/pts max=10 || failed=1
fi
check_option /sys ro || failed=1
check_option /sys/kernel/tracing gid=3012 || failed=1
check_root /storage /user/0 || failed=1
check_propagation /storage no yes || failed=1
check_root /mnt/installer /user || failed=1
check_root /mnt/androidwritable /user || failed=1
check_propagation /mnt/installer yes yes || failed=1
check_propagation /mnt/androidwritable yes yes || failed=1
# AOSP requests 0755, but Waydroid requires 01777 so its host-context
# hwcomposer can create /dev/input after Wayland seat discovery. Assert the
# known divergence explicitly so it can never be mislabeled as exact.
check_stat /dev 1777 0 0 || failed=1
check_stat /dev/ptmx 666 0 0 || failed=1
check_char_device /dev/ptmx 5 2 || failed=1
check_stat /mnt 755 0 1000 || failed=1
check_stat /apex 755 0 0 || failed=1
check_stat /linkerconfig 755 0 0 || failed=1
check_stat /data_mirror 700 0 1000 || failed=1

# Filesystem identities for every literal static mount that survives Android's
# second stage. Flags are checked above where AOSP specifies restrictions.
check_fs /dev tmpfs || failed=1
check_fs /mnt tmpfs || failed=1
check_fs /apex tmpfs || failed=1
check_fs /linkerconfig tmpfs || failed=1
check_fs /config configfs || failed=1
check_fs /sys/kernel/tracing tracefs || failed=1
check_fs /sys/fs/fuse/connections fusectl || failed=1
check_fs /sys/fs/bpf bpf || failed=1
check_fs /sys/fs/pstore pstore || failed=1
check_fs /data_mirror tmpfs || failed=1

# These absences are part of the closed comparison. They are architectural
# substitutions or expected post-second-stage removals, never silent omissions.
check_absent /sys/fs/selinux 'SELinux disabled; a fake selinuxfs is not equivalent' || failed=1
check_absent /dev/binderfs 'host binder devices substitute for Android binderfs' || failed=1
if (( android_sdk >= 37 )); then
    # Current init bind-mounts /data/metadata. Waydroid supplies the same data
    # through its host-backed data tree instead of a metadata block partition.
    check_root_suffix /metadata /data/metadata || failed=1
    check_option /metadata nosuid || failed=1
    check_option /metadata nodev || failed=1
    check_option /metadata noatime || failed=1
    check_fs /mnt/vm tmpfs || failed=1
    check_option /mnt/vm nosuid || failed=1
    check_option /mnt/vm nodev || failed=1
    check_option /mnt/vm noexec || failed=1
    check_fs /sys/kernel/security securityfs || failed=1
else
    check_absent /metadata 'Waydroid has no Android metadata block partition' || failed=1
fi
check_absent /debug_ramdisk 'AOSP second stage removes the transient mount' || failed=1
check_absent /second_stage_resources 'AOSP second stage removes the transient mount' || failed=1
check_absent /sys/kernel/debug 'init-debug.rc condition is false for this image' || failed=1

# The bootstrap linker namespace is a second bind on the same target. Confirm
# the exact /bootstrap root instead of accepting only the initial tmpfs line.
if awk '$5 == "/linkerconfig" && $4 == "/bootstrap" { found=1 } END { exit !found }' "$mountinfo_file"; then
    printf 'PASS %-24s bootstrap bind root=/bootstrap\n' /linkerconfig
else
    printf 'FAIL %-24s missing bootstrap bind root=/bootstrap\n' /linkerconfig
    failed=1
fi

# APEX topology is selected by the image. Android 13 flattened APEX bind-mounts
# /system/apex directories, while current Android uses read-only loop-backed
# packaged APEX images. Validate the complete topology instead of assuming one.
while IFS= read -r line; do
    target=$(awk '{ print $5 }' <<< "$line")
    root=$(awk '{ print $4 }' <<< "$line")
    if [[ $apex_updatable == true ]]; then
        source=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "-") { print $(i + 2); exit } }' <<< "$line")
        check_fs_one_of "$target" ext4,erofs || failed=1
        check_option "$target" ro || failed=1
        check_option "$target" nodev || failed=1
        check_option "$target" noatime || failed=1
        if [[ $root != / || $source != /dev/block/loop* ]]; then
            printf 'FAIL %-52s packaged APEX root=%s source=%s\n' "$target" "$root" "$source"
            failed=1
        fi
    elif [[ $root != /system/apex/* ]]; then
        printf 'FAIL %-52s flattened APEX root is %s\n' "$target" "$root"
        failed=1
    fi
done < <(awk '$5 ~ "^/apex/" { print }' "$mountinfo_file")

# init.rc creates recursive data mirrors from these exact Android source
# directories. Waydroid's host bind exposes a host-specific prefix in field 4,
# so compare the invariant source suffix rather than accepting an arbitrary
# bind root.
declare -A mirror_root_suffixes=(
    [/data/user/0]='/data/data'
    [/data_mirror/data_ce/null]='/data/user'
    [/data_mirror/data_ce/null/0]='/data/data'
    [/data_mirror/data_de/null]='/data/user_de'
    [/data_mirror/misc_ce/null]='/data/misc_ce'
    [/data_mirror/misc_de/null]='/data/misc_de'
    [/data_mirror/cur_profiles]='/data/misc/profiles/cur'
    [/data_mirror/ref_profiles]='/data/misc/profiles/ref'
)
for target in "${!mirror_root_suffixes[@]}"; do
    check_root_suffix "$target" "${mirror_root_suffixes[$target]}" || failed=1
done

# AOSP vold MountUserFuse requests exactly
# NOSUID|NODEV|NOEXEC|NOATIME|LAZYTIME. lazytime is reported in super options.
while IFS= read -r target; do
    check_fs "$target" fuse || failed=1
    for option in nosuid nodev noexec noatime lazytime; do
        check_option "$target" "$option" || failed=1
    done
done < <(awk '$5 ~ "^/mnt/user/[0-9]+/[^/]+$" || $5 ~ "^/storage/[^/]+$" || $5 ~ "^/mnt/(installer|androidwritable)/[0-9]+/[^/]+$" { print $5 }' "$mountinfo_file")

# MountUserFuse bind-mounts the lower media directory into pass_through. vold
# then bind-mounts the real Android/data and Android/obb directories over every
# exposed view. Validate every one; checking a single representative would let
# a partially divergent topology pass.
check_root_suffix /mnt/pass_through/0/emulated /data/media || failed=1
while IFS= read -r target; do
    case "$target" in
        */Android/data) expected=/data/media/0/Android/data ;;
        */Android/obb) expected=/data/media/0/Android/obb ;;
        *) continue ;;
    esac
    check_root_suffix "$target" "$expected" || failed=1
    for option in nosuid nodev noatime; do
        check_option "$target" "$option" || failed=1
    done
done < <(awk '$5 ~ "/Android/(data|obb)$" { print $5 }' "$mountinfo_file")

# Closed-world coverage: every effective mount must be tied to a literal AOSP
# request or to a named, documented Waydroid/LXC substitution. Unknown entries
# fail the audit so an image or Waydroid update cannot silently escape review.
declare -A category_counts=()
classified=0
unknown=0
while IFS= read -r target; do
    if category=$(classify_mount "$target"); then
        (( category_counts[$category] += 1 )) || true
        (( classified += 1 )) || true
        if [[ ${1:-} == --verbose ]]; then
            printf 'COVER %-52s %s\n' "$target" "$category"
        fi
    else
        printf 'FAIL %-52s unclassified runtime mount\n' "$target"
        (( unknown += 1 )) || true
        failed=1
    fi
done < <(awk '{ print $5 }' "$mountinfo_file")

printf 'COVERAGE runtime_mounts=%d classified=%d unknown=%d\n' \
    "$(( classified + unknown ))" "$classified" "$unknown"
for category in "${!category_counts[@]}"; do
    printf 'CATEGORY %-36s %d\n' "$category" "${category_counts[$category]}"
done | sort

exit "$failed"
