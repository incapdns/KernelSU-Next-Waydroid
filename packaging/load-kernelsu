#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
    echo "${0##*/}: execute como root." >&2
    exit 1
fi

kernel_release=$(uname -r)
module_path=$(modinfo -n kernelsu 2>/dev/null || true)
if [[ -z $module_path ]]; then
    module_path=$(find "/usr/lib/modules/${kernel_release}"/{extras,updates} \
        -iname 'kernelsu.ko*' -print -quit 2>/dev/null || true)
fi
if [[ -z $module_path ]]; then
    echo "${0##*/}: kernelsu.ko não existe para ${kernel_release}." >&2
    exit 1
fi

if ! grep -wq ext4 /proc/modules; then
    modprobe ext4
fi

if [[ ${1:-} == --unload-first || ${1:-} == -d ]]; then
    if grep -q '^kernelsu ' /proc/modules; then
        rmmod kernelsu
    fi
fi

case "$module_path" in
    *.zst) zstdcat "$module_path" | modloader - ;;
    *.xz) xzcat "$module_path" | modloader - ;;
    *.gz) gzip -dc "$module_path" | modloader - ;;
    *) cat "$module_path" | modloader - ;;
esac

# Module teardown removes the Android daemon. Restore the package-matched
# binary while Waydroid is stopped so Android init can execute post-fs-data
# before the first Zygote on the next container boot.
if [[ ${1:-} == --unload-first || ${1:-} == -d ]]; then
    packaged_ksud=/usr/lib/kernelsu-next-waydroid/ksud-x86_64
    if [[ -x $packaged_ksud ]]; then
        restored=0
        for adb_dir in /home/*/.local/share/waydroid/data/adb /var/lib/waydroid/data/adb; do
            [[ -d $adb_dir ]] || continue
            install -o root -g root -m 0755 "$packaged_ksud" "$adb_dir/ksud"
            echo "${0##*/}: restored package-matched ksud at $adb_dir/ksud"
            restored=1
        done
        if (( ! restored )); then
            echo "${0##*/}: warning: no Waydroid data/adb directory found; ksud was not restored." >&2
        fi
    fi
fi
