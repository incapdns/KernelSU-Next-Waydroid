#!/usr/bin/env bash
set -euo pipefail

log() {
    logger -t kernelsu-waydroid-pre-start -- "$*" 2>/dev/null || true
}
trap 'status=$?; log "failed at line $LINENO with status $status"' ERR

# lxc.hook.pre-start runs in the host namespace after the previous container
# has stopped and before the next Android init exists. KernelSU boot stages are
# one-shot per module load, so every new container init requires a fresh module
# lifecycle for post-fs-data and pre-Zygote modules such as Zygisk Next.
exec 9>/run/kernelsu-waydroid-pre-start.lock
flock 9

if grep -q '^kernelsu ' /proc/modules; then
    log "resetting KernelSU safely before Waydroid init"
    timeout --signal=TERM --kill-after=5s 30s \
        /usr/bin/load-kernelsu --unload-first
else
    log "loading KernelSU before Waydroid init"
    timeout --signal=TERM --kill-after=5s 30s /usr/bin/load-kernelsu
fi

grep -q '^kernelsu ' /proc/modules || {
    echo "${0##*/}: kernelsu module is not loaded" >&2
    exit 1
}
log "KernelSU is ready for Waydroid init"
